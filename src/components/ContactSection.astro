---
import type { SiteContent } from '../content/site';
import SectionHeading from './SectionHeading.astro';
interface Props { contact: SiteContent['contact']; section: SiteContent['sections']['contact']; }
const { contact, section } = Astro.props;
---
<section class="contact section-shell" id="contact" aria-labelledby="contact-title">
  <div class="contact__glow" aria-hidden="true"></div>
  <SectionHeading id="contact-title" eyebrow={section.eyebrow} title={section.title} />
  <div class="contact-grid"><figure class="contact-image reveal"><img src={contact.image} alt={contact.imageAlt} loading="lazy" /></figure>
    <div class="contact-copy"><p>{contact.text.split('\n\n').map((paragraph, index) => <span class="contact-copy__paragraph">{paragraph}{index === 0 && <><br /><br /></>}</span>)}</p>
      {contact.emailIsPlaceholder ? <span class="contact-email">{contact.email}</span> : <a class="contact-email" href={`mailto:${contact.email}`}>{contact.email}</a>}
      <ul class="social-links" aria-label="Redes sociales">
        {contact.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`Visitar ${link.label} de Carlos Arriezu`}>
          {link.label === 'Facebook' && <img src="https://cdn.simpleicons.org/facebook/1877F2" alt="" />}
          {link.label === 'Instagram' && <img src="https://cdn.simpleicons.org/instagram" alt="" />}
          {link.label === 'Spotify' && <img src="https://cdn.simpleicons.org/spotify/1ED760" alt="" />}
          {link.label === 'YouTube' && <img src="https://cdn.simpleicons.org/youtube/FF0000" alt="" />}
        </a></li>)}
      </ul>
      <div class="contact-piano" aria-label="Piano interactivo">
        <div class="contact-piano__topline"><span class="contact-piano__label">Play a tone</span><span class="contact-piano__status">signal / live</span></div>
        <div class="contact-piano__instrument">
          <div class="contact-piano__controls" aria-hidden="true"><i></i><i></i><i></i><span>ARRIEZU // SYNTH</span></div>
          <div class="contact-piano__keys">
            {['C4', 'D4', 'E4', 'F4', 'G4', 'A4', 'B4', 'C5'].map((note) => <button type="button" data-note={note} aria-label={`Tocar nota ${note}`}></button>)}
            {['C#4', 'D#4', 'F#4', 'G#4', 'A#4'].map((note, index) => <button class="contact-piano__black-key" style={`left: ${[10.5, 23.5, 48, 61, 74][index]}%`} type="button" data-note={note} aria-label={`Tocar nota ${note}`}></button>)}
          </div>
        </div>
        <div class="contact-piano__signal" aria-hidden="true">
          {Array.from({ length: 16 }).map(() => <span></span>)}
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const lifecycleKey = '__contactPianoLifecycle';
    if (window[lifecycleKey]) {
      window[lifecycleKey].initialize();
      return;
    }

    let cleanup = () => {};
    let activePiano;

    const initializePiano = () => {
      const piano = document.querySelector('.contact-piano');
      if (piano && piano === activePiano) return;
      cleanup();
      activePiano = piano;

      const keys = [...document.querySelectorAll('.contact-piano__keys button')];
      const signal = piano?.querySelector('.contact-piano__signal');
      if (!piano || !keys.length || !signal) return;

      const frequencies = { C4: 261.63, 'C#4': 277.18, D4: 293.66, 'D#4': 311.13, E4: 329.63, F4: 349.23, 'F#4': 369.99, G4: 392, 'G#4': 415.3, A4: 440, 'A#4': 466.16, B4: 493.88, C5: 523.25 };
      let audioContext;
      const timers = new Set();

      const getAudioContext = () => {
        if (!audioContext) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return null;
          audioContext = new AudioContextClass();
        }
        return audioContext;
      };

      const playNote = async (key) => {
        const note = key.dataset.note;
        const context = getAudioContext();
        if (!note || !context) return;
        if (context.state === 'suspended') {
          try {
            await context.resume();
          } catch {
            return;
          }
        }
        const oscillator = context.createOscillator();
        const gain = context.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = frequencies[note];
        gain.gain.setValueAtTime(.0001, context.currentTime);
        gain.gain.exponentialRampToValueAtTime(.16, context.currentTime + .015);
        gain.gain.exponentialRampToValueAtTime(.0001, context.currentTime + .55);
        oscillator.connect(gain).connect(context.destination);
        oscillator.start();
        oscillator.stop(context.currentTime + .6);
        key.classList.add('is-active');
        const timer = window.setTimeout(() => {
          key.classList.remove('is-active');
          timers.delete(timer);
        }, 260);
        timers.add(timer);
        signal.classList.remove('is-live');
        signal.querySelectorAll('span').forEach((bar) => { bar.style.setProperty('--bar-height', `${25 + Math.random() * 75}%`); });
        requestAnimationFrame(() => signal.classList.add('is-live'));
      };

      const handlers = keys.map((key) => {
        let pointerTriggered = false;
        const onPointerDown = (event) => {
          pointerTriggered = false;
          if (event.pointerType !== 'mouse' || event.button !== 0) return;
          pointerTriggered = true;
          void playNote(key);
        };
        const onPointerEnter = (event) => {
          if (event.pointerType === 'mouse' && (event.buttons & 1) === 1) void playNote(key);
        };
        const onClick = () => {
          if (pointerTriggered) {
            pointerTriggered = false;
            return;
          }
          void playNote(key);
        };
        key.addEventListener('pointerdown', onPointerDown);
        key.addEventListener('pointerenter', onPointerEnter);
        key.addEventListener('click', onClick);
        return () => {
          key.removeEventListener('pointerdown', onPointerDown);
          key.removeEventListener('pointerenter', onPointerEnter);
          key.removeEventListener('click', onClick);
        };
      });

      cleanup = () => {
        handlers.forEach((removeHandlers) => removeHandlers());
        timers.forEach((timer) => window.clearTimeout(timer));
        audioContext?.close();
      };
    };

    window[lifecycleKey] = { initialize: initializePiano };
    document.addEventListener('astro:page-load', initializePiano);
    initializePiano();
  })();
</script>
