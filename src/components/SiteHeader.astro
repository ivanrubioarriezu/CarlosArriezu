---
import type { NavigationItem } from '../content/site';
interface Props { artistName: string; navigation: NavigationItem[]; activeHref?: string; }
const { artistName, navigation, activeHref } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (href: string) => href === '/' ? `${base || ''}/` : `${base}${href}`;
---
<header class="site-header">
  <a class="wordmark" href={withBase('/')} aria-label={`Ir al inicio de ${artistName}`}><span class="wordmark-mark">●</span><span>{artistName}</span></a>
  <nav class="desktop-nav" aria-label="Navegación principal">
    {navigation.map(({ label, href }) => <a href={withBase(href)} aria-current={activeHref === href ? 'page' : undefined}>{label}</a>)}
  </nav>
  <details class="mobile-nav">
    <summary aria-label="Abrir menú">Menú <span>+</span></summary>
    <nav aria-label="Navegación móvil">
      {navigation.map(({ label, href }) => <a href={withBase(href)} aria-current={activeHref === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </details>
</header>
