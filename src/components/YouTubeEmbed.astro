---
interface Props { image: string; imageAlt: string; title: string; videoUrl: string; }
const { title, videoUrl } = Astro.props;

const getYouTubeId = (url: string) => {
  try {
    const parsed = new URL(url);
    const hostname = parsed.hostname.replace(/^www\./, '');

    if (hostname === 'youtu.be') {
      return parsed.pathname.replace('/', '').split('?')[0];
    }

    if (hostname.includes('youtube.com')) {
      const v = parsed.searchParams.get('v');
      if (v) return v;
      const shortPath = parsed.pathname.replace(/^\//, '');
      if (shortPath.startsWith('embed/')) return shortPath.replace('embed/', '').split('/')[0];
      if (shortPath.startsWith('shorts/')) return shortPath.replace('shorts/', '').split('/')[0];
    }

    return null;
  } catch {
    return null;
  }
};

const videoId = getYouTubeId(videoUrl);
if (!videoId) throw new Error(`No se ha encontrado un ID de YouTube para ${title}.`);
const embedUrl = `https://www.youtube-nocookie.com/embed/${videoId}?rel=0`;
---
<div class="youtube-embed">
  <iframe src={embedUrl} title={`Vídeo de YouTube: ${title}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
</div>
