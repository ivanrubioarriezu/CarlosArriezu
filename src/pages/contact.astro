---
import ContactSection from '../components/ContactSection.astro';
import PageIntro from '../components/PageIntro.astro';
import PageLayout from '../components/PageLayout.astro';
import { siteContent } from '../content/site';
---
<PageLayout title={`${siteContent.contact.title} — ${siteContent.meta.title}`} description={siteContent.meta.description} artistName={siteContent.artist.name} navigation={siteContent.navigation} activeHref="/contact">
  <PageIntro variant="contact" eyebrow={siteContent.sections.contact.eyebrow} title={siteContent.contact.title} description={siteContent.contact.text} />
  <ContactSection contact={siteContent.contact} section={siteContent.sections.contact} />
</PageLayout>
